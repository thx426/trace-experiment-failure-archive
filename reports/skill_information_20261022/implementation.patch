+#!/usr/bin/env python3
+"""Reproduce the bounded WebShop ASIN audit on a hashed evidence export.
+
+CPU only; no model calls. The export binds each rollout to its exact research
+archive and actual training row. A zero finding is NOT semantic clearance.
+Run: python3 scripts/classic/audit_skill_information.py evidence.json.gz --out report-dir
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+from collections import Counter, defaultdict
+import gzip
+import hashlib
+import json
+from pathlib import Path
+import re
+
+
+def refs(text):
+    return {x.upper() for x in re.findall(r'\bB[0-9A-Z]{9}\b', text or '', re.I)}
+
+
+def analyse(data):
+    # The audited run uses WebShop text protocol. Only literals in its actual
+    # system prompt function / shared role text count, not unrelated API examples.
+    tree = ast.parse(data['sources']['src/trace_opd/envs/webshop/adapter.py']['text'])
+    nodes = [n for n in tree.body if
+             (isinstance(n, ast.FunctionDef) and n.name == 'system_prompt_text') or
+             (isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and
+              t.id == '_ROLE_AND_STYLE' for t in n.targets))]
+    if not nodes:
+        raise ValueError('cannot reconstruct public WebShop text scaffold')
+    public_ids = set().union(*(refs(n.value) for root in nodes for n in ast.walk(root)
+                              if isinstance(n, ast.Constant) and isinstance(n.value, str)))
+    joined = {}
+    for bundle in data['training_audits']:
+        assert bundle['summary']['audit_status'] == 'ok'
+        assert bundle['actor_update']['audit_id'] == bundle['summary']['audit_id']
+        for row in bundle['rows']:
+            key = row['global_step'], row['sample_id'], row['tags'].get('attempt_id')
+            assert key not in joined, f'duplicate training row: {key}'
+            joined[key] = row
+    stats = defaultdict(Counter)
+    used, findings = set(), []
+    for row in data['rows']:
+        key = row['global_step'], row['sample_id'], row['attempt_id']
+        assert key in joined and key not in used, f'missing/duplicate rollout: {key}'
+        used.add(key)
+        train = joined[key]
+        assert train['reward'] == float(row['won'])
+        assert train['steer_arm'] == row['steering']['steer_arm']
+        count = stats[str(train['steer_arm'])]
+        advantage = train['advantage'] or 0
+        count['rows'] += 1
+        count['positive_rows'] += int(advantage > 0)
+        count['positive_mass_all_rows'] += max(advantage, 0)
+        doc = data['docs'].get(row['research'].get('research_archive'))
+        if not doc or not doc['text']:
+            count['missing_doc_rows'] += 1
+            continue
+        assert hashlib.sha256(doc['text'].encode()).hexdigest() == doc['sha256']
+        assert doc['meta']['task_id'] == row['task_id']
+        assert doc['meta']['global_step'] == row['global_step']
+        trajectory = row['trajectory']
+        assert isinstance(trajectory['initial_obs'], str) and trajectory['initial_obs']
+        seen = refs(trajectory['initial_obs']) | public_ids
+        doc_ids = refs(doc['text'])
+        count['doc_asin_rows'] += int(bool(doc_ids))
+        count['initial_unobserved_doc_rows'] += int(bool(doc_ids - seen))
+        events, tainted = [], False
+        for step in trajectory['steps']:
+            action = refs(step.get('action_norm') or step.get('action_raw'))
+            thought = refs(step.get('thought'))
+            missing_action, missing_thought = action & doc_ids - seen, thought & doc_ids - seen
+            if missing_action or missing_thought:
+                events.append({'turn': step['t'], 'action_ids': sorted(missing_action),
+                               'thought_ids': sorted(missing_thought)})
+            if missing_action:
+                tainted = True
+            if not tainted:
+                observed = refs(step.get('observation'))
+                if step.get('valid') is False or step.get('acted') is False:
+                    observed -= action | thought
+                seen |= observed
+        action_hit = any(e['action_ids'] for e in events)
+        count['before_exposure_action_rows'] += int(action_hit)
+        count['before_exposure_any_rows'] += int(bool(events))
+        count['before_exposure_action_positive_rows'] += int(action_hit and advantage > 0)
+        count['positive_mass'] += max(advantage, 0)  # only rows with nonempty docs
+        if events:
+            findings.append({'key': key, 'task_id': row['task_id'], 'events': events,
+                             'doc_path': doc['path'], 'doc_sha256': doc['sha256'],
+                             'source': row['source_path'], 'source_sha256': row['source_sha256']})
+    assert used == set(joined), 'training rows without matching rollout evidence'
+    assert not data['read_failures'], 'export has read failures; do not certify coverage'
+    summary = {
+        'scope': 'WebShop control pilot steps 1-14; ASIN literal audit, not semantic or causal proof',
+        'public_scaffold_literal_ids': sorted(public_ids),
+        'case_normalization': 'ASIN case-insensitive; supersedes initial uppercase-only audit',
+        'raw_rows': len(data['rows']), 'training_rows': len(joined), 'matched_rows': len(used),
+        'unmatched_rollouts': 0, 'unmatched_training_rows': 0,
+        'read_failures': data['read_failures'], 'doc_archives': len(data['docs']),
+        'nonempty_docs': sum(bool(v['text']) for v in data['docs'].values()),
+        'docs_with_asin': sum(bool(refs(v['text'])) for v in data['docs'].values()),
+        'arm_stats': dict(stats),
+    }
+    return summary, findings
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('evidence', type=Path)
+    parser.add_argument('--out', required=True, type=Path)
+    args = parser.parse_args()
+    with gzip.open(args.evidence, 'rt') as file:
+        summary, findings = analyse(json.load(file))
+    summary['input_sha256'] = hashlib.sha256(args.evidence.read_bytes()).hexdigest()
+    args.out.mkdir(parents=True, exist_ok=True)
+    for name, value in [('summary', summary), ('findings', findings)]:
+        (args.out / f'{name}.json').write_text(json.dumps(value, ensure_ascii=False, indent=2))
+    print(json.dumps(summary, ensure_ascii=False, indent=2))
+
+
+if __name__ == '__main__':
+    main()
