+"""Evidence identity and observation-order regressions for the offline audit."""
+import copy
+import hashlib
+import importlib.util
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location('skill_audit', ROOT / 'scripts/classic/audit_skill_information.py')
+audit = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(audit)
+
+
+def evidence(steps):
+    doc = 'Click B08P8LRFZ4.'
+    return {
+        'sources': {'src/trace_opd/envs/webshop/adapter.py': {
+            'text': '_ROLE_AND_STYLE = "Find a product"\ndef system_prompt_text():\n return _ROLE_AND_STYLE\n'}},
+        'read_failures': [],
+        'docs': {'research/one': {'text': doc, 'sha256': hashlib.sha256(doc.encode()).hexdigest(),
+                                  'path': '/run/doc.md', 'meta': {'task_id': 'task', 'global_step': 1}}},
+        'training_audits': [{'summary': {'audit_status': 'ok', 'audit_id': 'x'},
+                             'actor_update': {'audit_id': 'x'}, 'rows': [{
+                                 'global_step': 1, 'sample_id': 'sample', 'tags': {'attempt_id': 'try'},
+                                 'reward': 1, 'steer_arm': 1, 'advantage': 0.5}]}],
+        'rows': [{'global_step': 1, 'sample_id': 'sample', 'attempt_id': 'try', 'task_id': 'task',
+                  'won': True, 'steering': {'steer_arm': 1}, 'research': {'research_archive': 'research/one'},
+                  'source_path': '/run/row.json', 'source_sha256': 'fixture',
+                  'trajectory': {'initial_obs': 'Find a chair.', 'steps': steps}}],
+    }
+
+
+class SkillAuditTests(unittest.TestCase):
+    def test_lowercase_action_cannot_use_future_observation(self):
+        data = evidence([{'t': 1, 'action_norm': 'click[b08p8lrfz4]', 'observation': 'B08P8LRFZ4'}])
+        summary, findings = audit.analyse(data)
+        self.assertEqual(summary['arm_stats']['1']['before_exposure_action_positive_rows'], 1)
+        self.assertEqual(findings[0]['events'][0]['action_ids'], ['B08P8LRFZ4'])
+
+    def test_discovery_precedes_use(self):
+        data = evidence([{'t': 1, 'action_norm': 'search[chair]', 'observation': 'B08P8LRFZ4'},
+                         {'t': 2, 'action_norm': 'click[b08p8lrfz4]'}])
+        self.assertEqual(audit.analyse(data)[1], [])
+
+    def test_wrong_archive_version_is_rejected(self):
+        data = evidence([])
+        data['docs']['research/one']['meta']['global_step'] = 2
+        with self.assertRaises(AssertionError):
+            audit.analyse(data)
+
+    def test_duplicate_rollouts_are_not_counted_twice(self):
+        data = evidence([])
+        data['rows'].append(copy.deepcopy(data['rows'][0]))
+        with self.assertRaises(AssertionError):
+            audit.analyse(data)
+
+
+if __name__ == '__main__':
+    unittest.main()
