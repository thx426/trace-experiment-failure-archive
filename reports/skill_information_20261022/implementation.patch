+"""Conservative literal provenance checks, NOT a semantic leakage detector.
+
+An unobserved locator is a review candidate, not proof of leakage. The optional
+pre-sampling guard rejects the *whole document*, avoiding loss-mask surgery on
+trajectories whose later states already depend on privileged actions. It may
+reject legitimate output paths, common URLs and conditional instructions.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from collections.abc import Iterable
+
+VERSION = "literal-provenance-v1"
+MODES = ("off", "reject_unobserved_locators")
+# Deliberately bounded scope: absolute POSIX paths, HTTP URLs, WebShop ASINs.
+# No claims about relative paths, arbitrary answers, symbols or natural language.
+_LOCATOR = re.compile(
+    r"https?://[^\s<>\"'`\[\]{}()]+"
+    r"|(?<![\w:/<])/(?:[A-Za-z0-9_.~-]+/)*[A-Za-z0-9_.~-]+"
+    r"|(?P<asin>\b(?i:B[0-9A-Z]{9})\b)"
+)
+
+
+def locators(text: str) -> set[str]:
+    # WebShop actions commonly lowercase ASINs. Paths/URLs remain case-sensitive.
+    return {m.group().upper() if m.group("asin") else m.group().rstrip(".,;:!?")
+            for m in _LOCATOR.finditer(text)}
+
+
+def screen_guidance(doc: str, public_texts: Iterable[str], mode: str) -> tuple[str, dict]:
+    """Only pass actual student-visible initial input here, never task metadata/GT.
+
+    Text matching is evidence of exposure, not truth, authority or derivability.
+    Off preserves historical sampling; it still reports review candidates.
+    """
+    if mode not in MODES:
+        raise ValueError(f"unknown information guard mode: {mode}")
+    public = set().union(*(locators(text) for text in public_texts))
+    candidates = sorted(locators(doc) - public)
+    blocked = mode == "reject_unobserved_locators" and bool(candidates)
+    return ("" if blocked else doc), {
+        "version": VERSION, "mode": mode,
+        "doc_sha256": hashlib.sha256(doc.encode()).hexdigest(),
+        "unobserved_locators": candidates, "blocked": blocked,
+        "scope": "literal exposure only; no semantic safety certification",
+    }
+
+
+def audit_trajectory(doc: str, initial_public: Iterable[str], steps: list[dict]) -> dict:
+    """Check each action/thought BEFORE adding that turn's observation.
+
+    Assistant statements never count as new public evidence. After a suspect
+    action, later observations are tainted for this audit: they cannot certify
+    an independently discoverable prefix. A clean replay is needed to repair it.
+    Missing initial input must be reported by callers, not replaced by GT.
+    """
+    public = set().union(*(locators(text) for text in initial_public))
+    doc_refs = locators(doc)
+    first_exposure = {ref: "initial_input" for ref in public}
+    findings = []
+    tainted = False
+    for position, step in enumerate(steps):
+        turn = step.get("t", position + 1)
+        action = str(step.get("action_norm") or step.get("action_raw") or "")
+        thought = str(step.get("thought") or "")
+        for ref in sorted((locators(action) | locators(thought)) & doc_refs - public):
+            findings.append({"turn": turn, "locator": ref,
+                             "in_action": ref in locators(action),
+                             "in_thought": ref in locators(thought),
+                             "kind": "doc_literal_before_clean_public_exposure"})
+        if (locators(action) & doc_refs) - public:
+            tainted = True
+        if not tainted:
+            # An environment error may merely echo a guessed identifier. Never
+            # let an invalid/no-op action launder it into established evidence.
+            observed = locators(str(step.get("observation") or ""))
+            if step.get("valid") is False or step.get("acted") is False:
+                observed -= locators(action) | locators(thought)
+            for ref in observed - public:
+                first_exposure[ref] = f"observation_after_turn_{turn}"
+            public |= observed
+    return {"version": VERSION, "findings": findings,
+            "action_findings": sum(f["in_action"] for f in findings),
+            "thought_only_findings": sum(not f["in_action"] for f in findings),
+            "tainted_suffix": tainted,
+            "first_clean_exposure": {k: v for k, v in first_exposure.items() if k in doc_refs},
+            "status": "review" if findings else "no_literal_finding"}
